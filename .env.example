# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# From Supabase: click the Connect button -> choose Session pooler -> copy the string.
# Use the SESSION POOLER on your laptop AND on Render. The Direct connection is IPv6-only
# and fails on Render and on many home networks.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres

# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-this-with-a-generated-secret-key

# True locally, False in production
DEBUG=True

# Comma-separated. Add your Render domain here once deployed.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated. The frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://storesoko.netlify.app
